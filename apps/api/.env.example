# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://fnb_user:fnb_pass@localhost:5432/fnb_pos

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Default outlet + admin user created by `npm run seed`
SEED_OUTLET_CODE=main
SEED_OUTLET_NAME=Outlet Utama
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_FULL_NAME=Administrator
